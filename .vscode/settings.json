{
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "always",
      "source.fixAll.eslint": "always",
      "source.action.useSortedAttributes.biome": "always",
      "source.action.useSortedInterfaceMembers.biome": "always",
      "source.action.useSortedKeys.biome": "always",
      "source.action.useSortedProperties.biome": "always",
    },
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "always",
      "source.fixAll.eslint": "always",
      "source.action.useSortedAttributes.biome": "always",
      "source.action.useSortedInterfaceMembers.biome": "always",
      "source.action.useSortedKeys.biome": "always",
      "source.action.useSortedProperties.biome": "always",
    },
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "always",
      "source.fixAll.eslint": "always",
      "source.action.useSortedAttributes.biome": "always",
      "source.action.useSortedInterfaceMembers.biome": "always",
      "source.action.useSortedKeys.biome": "always",
      "source.action.useSortedProperties.biome": "always",
    },
  },
  "eslint.format.enable": true,
  "editor.formatOnSave": true,
  "editor.rulers": [
    120
  ],
  "editor.indentSize": 2,
  "files.eol": "\n",
  "files.autoSave": "onFocusChange",
  "typescript.tsdk": "node_modules/typescript/lib",
  "peacock.color": "slategray",
}