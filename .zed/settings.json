{
  "languages": {
    "CSS": {
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.action.useSortedAttributes.biome": true,
        "source.action.useSortedInterfaceMembers.biome": true,
        "source.action.useSortedKeys.biome": true,
        "source.action.useSortedProperties.biome": true,
      },
      "formatter": [
        { "language_server": { "name": "biome" } },
        { "code_action": "source.fixAll.eslint" },
      ],
    },
    "JSON": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.action.useSortedKeys.biome": true,
      },
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "TSX": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.action.useSortedAttributes.biome": true,
        "source.action.useSortedInterfaceMembers.biome": true,
        "source.action.useSortedKeys.biome": true,
        "source.action.useSortedProperties.biome": true,
      },
      "formatter": [
        { "language_server": { "name": "biome" } },
        { "code_action": "source.fixAll.eslint" },
      ],
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.action.useSortedAttributes.biome": true,
        "source.action.useSortedInterfaceMembers.biome": true,
        "source.action.useSortedKeys.biome": true,
        "source.action.useSortedProperties.biome": true,
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
      "formatter": [
        { "language_server": { "name": "biome" } },
        { "code_action": "source.fixAll.eslint" },
      ],
    },
  },
}
